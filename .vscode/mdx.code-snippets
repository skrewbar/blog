{
  "MDX Frontmatter": {
    "scope": "markdown,mdx",
    "prefix": ["frontmatter", "fm"],
    "body": [
      "---",
      "title: ${1:제목}",
      "description: ${2:설명}",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE} ${CURRENT_HOUR}:${CURRENT_MINUTE}",
      "slug: ${3:slug}",
      "category: ${4:카테고리}",
      "tags:",
      "  - ${5:태그}",
      "---",
      "",
      "$0",
    ],
    "description": "블로그 포스트 MDX frontmatter 템플릿",
  },
  "MDX Frontmatter (with cover)": {
    "scope": "markdown,mdx",
    "prefix": ["frontmatter-cover", "fmc"],
    "body": [
      "---",
      "title: \"${1:제목}\"",
      "description: \"${2:설명}\"",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE} ${CURRENT_HOUR}:${CURRENT_MINUTE}",
      "slug: ${3:slug}",
      "category: ${4:카테고리}",
      "tags:",
      "  - ${5:태그}",
      "cover: /${3:slug}/${6:cover.jpeg}",
      "---",
      "",
      "$0",
    ],
    "description": "커버 이미지가 있는 블로그 포스트 MDX frontmatter 템플릿",
  },
}
